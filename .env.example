TH_PORT=8700
TH_SECRET=change-me
# Базовый URL, по которому test_hub виден снаружи — используется для публичных
# ссылок на отчёты прогонов (см. раздел «Публичная ссылка на отчёт» в README).
TH_PUBLIC_URL=http://127.0.0.1:8700
# Пересчёт ETA очереди хуком после каждого прогона (0 — выключить, останется ручной POST .../eta/recalc)
TH_ETA_HOOK=1

# Telegram-бот (app/tg_bot.py): пусто = бот выключен.
TH_TG_BOT_TOKEN=
# CSV id пользователей Telegram, которым разрешено пользоваться ботом. Пусто = никому нельзя.
TH_TG_ALLOWED_IDS=
TH_TG_SERVICE_LOGIN=tg_bot
TH_TG_SERVICE_PASSWORD=tg_bot

# Встроенный демо-сервис (demo/app/) для проекта Demo — рабочий пример без
# реальных стендов. 1/0: включён по умолчанию. Порт — свой, отдельный от TH_PORT.
TH_DEMO=1
TH_DEMO_PORT=8710

# Sentry (блок ошибок продукта для QA, см. раздел «Sentry» в README). Пусто = блок
# отключён. Токен — Auth Token с правом только на чтение (Settings → Auth Tokens в Sentry).
TH_SENTRY_URL=
TH_SENTRY_TOKEN=
TH_SENTRY_ORG=

# YouTrack (вкладка «Новые дефекты» — подтверждение бага отправляет комментарий в
# один тикет-накопитель). Пусто = вкладка показывает «YouTrack не подключён».
# Токен — Permanent Token (Profile → Account Security → New token в YouTrack).
TH_YOUTRACK_URL=
TH_YOUTRACK_TOKEN=
TH_YOUTRACK_ISSUE=

# Путь к бинарнику allure CLI (см. раздел «Allure CLI» в README). Нужен для генерации
# Allure-отчёта в публичных ссылках на прогон. Пусто = искать в PATH и типичных
# каталогах установки — под launchd/systemd с урезанным PATH так найти его не выйдет,
# тогда укажите путь явно, например /opt/allure-2.32.0/bin/allure.
TH_ALLURE_BIN=

# Пароль для кастомных/ревью-стендов проекта <PROJECT> (use_env_flag=true, стенд с
# заполненным stands.env_name — см. вкладку «Стенды»): один общий пароль на все такие
# стенды проекта, пробрасывается дочернему pytest как STAND_PASSWORD. Решение владельца
# 23.10.2026 — не хранить пароли стендов в БД/API test_hub, только здесь, в .env сервера.
# STAND_LOGIN при этом берётся как обычно из поля «Логин» стенда. Имя переменной:
# TH_STAND_PASSWORD_ + имя проекта в ВЕРХНЕМ_РЕГИСТРЕ (не буквы/цифры -> "_"), например:
# TH_STAND_PASSWORD_VSHGU=
