TH_PORT=8700
TH_SECRET=change-me
# Базовый URL, по которому test_hub виден снаружи — используется для публичных
# ссылок на отчёты прогонов (см. раздел «Публичная ссылка на отчёт» в README).
TH_PUBLIC_URL=http://127.0.0.1:8700

# Telegram-бот (app/tg_bot.py): пусто = бот выключен.
TH_TG_BOT_TOKEN=
# CSV id пользователей Telegram, которым разрешено пользоваться ботом. Пусто = никому нельзя.
TH_TG_ALLOWED_IDS=
TH_TG_SERVICE_LOGIN=tg_bot
TH_TG_SERVICE_PASSWORD=tg_bot
