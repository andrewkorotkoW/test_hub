# Пример конфига nginx для test_hub: HTTPS-терминация + reverse proxy на uvicorn
# (127.0.0.1:8700, см. TH_PORT в .env) + отдельный location для WebSocket
# (/ws/runs/{run_id}, см. @ws_router.websocket в app/routers/runs.py).
#
# Установка:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/test_hub
#   # заменить example.com и пути сертификатов на реальные
#   sudo ln -s /etc/nginx/sites-available/test_hub /etc/nginx/sites-enabled/test_hub
#   sudo nginx -t && sudo systemctl reload nginx
#
# Сертификат (certbot, автообновление): sudo certbot --nginx -d example.com

upstream test_hub_upstream {
    server 127.0.0.1:8700;
}

# HTTP -> HTTPS редирект
server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # certbot использует этот location для ACME-challenge при выпуске/продлении сертификата
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name example.com;

    # Плейсхолдеры — путь certbot по умолчанию (/etc/letsencrypt/live/<domain>/) или
    # свои сертификаты.
    ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;

    client_max_body_size 20m;  # кадры UI-тестов и вложения к тест-кейсам (см. TH_FRAME_MAX_BYTES)

    location /ws/runs/ {
        proxy_pass http://test_hub_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 3600s;  # долгоживущее соединение на время прогона
    }

    location / {
        proxy_pass http://test_hub_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
